{
  "name": "deepautocode-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "DeepAutoCode UI (IDE workbench) running on top of the DeepSeek Harness kernel",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:ui": "vite build --config webview-min/vite.config.ts",
    "build:ui-legacy": "vite build --config webview/vite.config.ts",
    "build:host": "tsc -p tsconfig.json",
    "build": "npm run build:ui && npm run build:host",
    "start": "node scripts/start.cjs",
    "dev": "tsx host/main.ts",
    "desktop": "electron electron/main.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepautocode/agent": "file:../DeepAutoCode/deepautocode-agent",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "32.2.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
